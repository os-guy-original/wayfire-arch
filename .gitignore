# makepkg build byproducts (only PKGBUILD is tracked per package)
packages/*/pkg/
packages/*/src/
packages/*/wayfire/
packages/*/*.pkg.tar.zst
packages/*/*.log
packages/*/*.sig
packages/*/*.tar.gz
packages/*/PKGBUILD.bak

# The served repo tree (x86_64/) IS tracked, including its .db.tar.gz and .sig.

__pycache__/
*.pyc
