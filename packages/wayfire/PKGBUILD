# Maintainer: os-guy-original
pkgname=wayfire
pkgver=0.11.0
pkgrel=1
pkgdesc='3D wayland compositor'
arch=(x86_64)
url='https://github.com/WayfireWM/wayfire'
license=(MIT)
options=('!debug')
depends=(
  cairo
  glib2
  libevdev
  libglvnd
  libinput
  libjpeg-turbo
  libpng
  libxcb
  libxkbcommon
  pango
  pixman
  python
  systemd-libs
  wayland
  wayland-protocols
  'wf-config>=0.11.0'
  wlroots0.20
  xorg-xwayland
  yyjson
)
makedepends=(
  doctest
  git
  glm
  libxml2
  meson
  ninja
  wayland-protocols
)
# Built from git because wf-json, wf-utils and wf-touch are git submodules (the
# GitHub tarball ships them empty, which breaks meson).
source=("git+https://github.com/WayfireWM/wayfire.git#tag=v${pkgver}")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/wayfire"
  git submodule init
  # wf-config and wlroots come from the system; skip their submodules (and the
  # vulkan wlroots fork) so we do not pull them in.
  git config submodule.subprojects/wf-config.update none
  git config submodule.subprojects/wlroots.update none
  git config submodule.subprojects/wlroots-vkfx.update none
  git submodule update
}

# vulkan_effects stays at its default (false), which links upstream wlroots0.20
# rather than the wlroots-vkfx fork.
build() {
  cd "$srcdir/wayfire"
  arch-meson build \
    -Duse_system_wfconfig=enabled \
    -Duse_system_wlroots=enabled \
    -Dxwayland=enabled \
    -Dtests=disabled
  meson compile -C build
}

package() {
  cd "$srcdir/wayfire"
  DESTDIR="${pkgdir}" meson install -C build
}
